openapi: 3.1.0
info:
  title: Ceding Carrier Data API
  description: APIs for retrieving comprehensive policy data from ceding carriers including policy details, parties, contract values, allocations, riders, and benefits.
  version: 1.0.0
  license:
    name: MIT
    url: https://opensource.org/licenses/MIT

paths:
  /v1/policies/{policyNumber}:
    get:
      operationId: getCedingCarrierPolicy
      tags:
        - Ceding Carrier Policy Data
      summary: Retrieve ceding carrier policy data
      description: Retrieve comprehensive policy data from ceding carrier including all policy details, parties, contract values, fund allocations, riders, and benefits.
      parameters:
        - $ref: '#/components/parameters/policyNumber'
        - $ref: '#/components/parameters/correlationId'
      responses:
        '200':
          description: Policy data successfully retrieved
          headers:
            correlationId:
              $ref: '#/components/headers/correlationId'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PolicyResponse'
        '400': { $ref: '#/components/responses/BadRequestError' }
        '401': { $ref: '#/components/responses/UnauthorizedError' }
        '403': { $ref: '#/components/responses/ForbiddenError' }
        '404': { $ref: '#/components/responses/NotFoundError' }
        '405': { $ref: '#/components/responses/MethodNotAllowedError' }
        '429': { $ref: '#/components/responses/TooManyRequestsError' }
        '500': { $ref: '#/components/responses/InternalServerError' }
        '503': { $ref: '#/components/responses/ServiceUnavailableError' }
security:
  - oauth2: []
components:
  parameters:
    policyNumber:
      name: policyNumber
      in: path
      required: true
      description: Unique policy number (1 to 30 characters)
      schema:
        type: string
        minLength: 1
        maxLength: 30

    correlationId:
      name: correlationId
      in: header
      required: false
      description: Optional client-supplied identifier to trace the request
      schema:
        type: string
        maxLength: 100

  headers:
    correlationId:
      description: Correlates this response to requests and downstream logs
      schema:
        type: string
        maxLength: 100

  responses:
    BadRequestError:
      description: Bad Request
      headers:
        correlationId:
          $ref: '#/components/headers/correlationId'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

    UnauthorizedError:
      description: Unauthorized
      headers:
        correlationId:
          $ref: '#/components/headers/correlationId'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

    ForbiddenError:
      description: Forbidden
      headers:
        correlationId:
          $ref: '#/components/headers/correlationId'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

    NotFoundError:
      description: Not Found
      headers:
        correlationId:
          $ref: '#/components/headers/correlationId'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

    MethodNotAllowedError:
      description: Method Not Allowed
      headers:
        correlationId:
          $ref: '#/components/headers/correlationId'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

    TooManyRequestsError:
      description: Too Many Requests
      headers:
        correlationId:
          $ref: '#/components/headers/correlationId'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

    InternalServerError:
      description: Internal Server Error
      headers:
        correlationId:
          $ref: '#/components/headers/correlationId'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

    ServiceUnavailableError:
      description: Service Unavailable
      headers:
        correlationId:
          $ref: '#/components/headers/correlationId'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

  schemas:
    Error:
      type: object
      description: Standard error response schema
      required:
        - code
        - message
      properties:
        code:
          type: string
          description: Error code
        message:
          type: string
          description: Error message

    PolicyResponse:
      type: object
      description: Complete policy response from ceding carrier
      required:
        - policyNumber
        - parties
      properties:
        policyNumber:
          type: string
          minLength: 1
          maxLength: 30
          description: Unique identifier assigned to the contract by the insurer or cedent
        parties:
          $ref: '#/components/schemas/Parties'
        issuedDate:
          type: string
          format: date
          description: The official date on which the contract was issued (yyyy-mm-dd)
        productType:
          type: string
          enum:
            - disability
            - fixedIndexedAnnuity
            - fixedAnnuityProducts
            - fixedImmediateAnnuity
            - indexVariableAnnuity
            - fixedUniversalLifeInsurance
            - fixedWholeLifeInsurance
            - longTermCare
            - marketValueAdjustment
            - moneyMarketProducts
            - offshoreInvestmentProducts
            - pensionPlan
            - registeredIndexAnnuity
            - retirementPlan
            - termLife
            - variableAnnuityProducts
            - variableImmediateAnnuity
            - variableUniversalLifeInsurance
            - variableWholeLifeInsurance
            - indexLife
            - deferredIncomeAnnuity
            - contingentDeferredAnnuity
          description: The general classification of the annuity or insurance product
        productName:
          type: string
          maxLength: 100
          description: The marketing or legal name of the annuity or insurance product
        cusip:
          type: string
          minLength: 9
          maxLength: 9
          pattern: '^[0-9A-Z]{9}$'
          description: CUSIP code (9 characters with only letters and numbers)
        taxPlan:
          type: string
          enum:
            - qualified
            - nonQualified
            - rothIRA
            - traditionalIRA
            - sep
            - simple
            - plan403b
            - plan457b
          description: Indicates the IRS qualification type of the annuity contract
        cedingCompanyName:
          type: string
          maxLength: 100
          description: Name of the issuing insurance company (ceding company)
        maturityDate:
          type: string
          format: date
          description: Date on which the annuity contract is scheduled to mature (yyyy-mm-dd)
        contractValues:
          $ref: '#/components/schemas/ContractValues'
        fundAllocations:
          type: array
          description: List of fund allocations
          items:
            $ref: '#/components/schemas/FundAllocation'
        riderFees:
          type: array
          description: List of rider fees
          items:
            $ref: '#/components/schemas/RiderFee'
        livingBenefits:
          type: array
          description: List of living benefits
          items:
            $ref: '#/components/schemas/LivingBenefit'
        deathBenefits:
          type: array
          description: List of death benefits
          items:
            $ref: '#/components/schemas/DeathBenefit'
        ltcRider:
          $ref: '#/components/schemas/LTCRider'

    Parties:
      type: array
      minItems: 1
      maxItems: 180
      description: List of individuals or entities related to the policy
      items:
        $ref: '#/components/schemas/Party'

    Party:
      type: object
      description: Individual or entity party to the policy
      anyOf: 
        - required: [type,role,firstName,lastName]
        - required: [type,role,name]        
      properties:
        type:
          type: string
          enum:
            - person
            - nonPersonEntity
            - unknown
            - corporation
            - trust
            - plan
            - limitedLiabilityCorporation
            - partnership
            - assignee
            - custodian
            - nonProfitOrganization
            - soleProprietorship
            - government
            - charitableOrganization
            - charitableRemainderTrust
            - ugmaUtma
            - grantorTrust
            - nonGrantorTrust
            - estate
          description: Type of party
        role:
          type: string
          enum:
            - owner
            - jointOwner
            - annuitant
            - jointAnnuitant
            - contingentAnnuitantInsured
            - contingentOwner
            - trustee
            - powerOfAttorney
            - custodianUGMA
            - insured
            - jointInsured
            - decedent
            - ownerAnnuitant
          description: Role on the contract
        firstName:
          type: string
          maxLength: 180
          description: Party's first name
        middleName:
          type: string
          maxLength: 180
          description: Party's middle name
        lastName:
          type: string
          maxLength: 180
          description: Party's last name
        name:
          type: string
          maxLength: 180
          description: Entity name (for non-individual parties)
        ownerTaxId:
          type: string
          minLength: 4
          maxLength: 4
          pattern: '^[0-9]{4}$'
          description: Owner's tax ID (Last 4 digits)
        insuredTaxId:
          type: string
          minLength: 4
          maxLength: 4
          pattern: '^[0-9]{4}$'
          description: Insured's tax ID (Last 4 digits)

    ContractValues:
      type: object
      description: Policy contract value information
      properties:
        contractValue:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: Gross contract value at valuation date, before loans, fees, or any other charges
        surrenderValue:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: The net amount available to the contract owner upon full surrender
        surrenderCharge:
          type: number
          format: float
          description: The dollar amount or percentage reduction applied upon surrender
        surrenderChargeType:
          type: string          
          enum: [currency,percentage]
          description: Indicates the unit of the surrenderCharge field
        surrenderChargeExpirationDate:
          type: string
          format: date
          description: The date after which no surrender charge applies (yyyy-mm-dd)
        minimumGuaranteedDeathBenefit:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: Minimum amount payable to beneficiary upon death
        minimumWithdrawalValue:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: Minimum allowed withdrawal amount
        totalAnnualCharges:
          type: number
          format: float
          minimum: 0
          maximum: 100
          description: Total annualized cost as a percentage of contract value (0-100)
        initialPremium:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: Total premium amount paid at contract issue

    FundAllocation:
      type: object
      description: Fund allocation details
      properties:
        allocation:
          type: string
          maxLength: 180
          description: Name of the allocation
        allocationPercentage:
          type: number
          format: float
          minimum: 0
          maximum: 100
          description: Percentage of funds in the allocation (0-100)
        rateType:
          type: string
          enum:
            - cap
            - buffer
            - par
            - trigger
            - triggerWithinBuffer
            - triggerBailoutRate
            - capWithBuffer
            - minimumCapDuringCDSD
          description: The type of rate applicable to the allocation
        rateValue:
          type: number
          format: float
          minimum: 0
          maximum: 100
          description: The value of the rate as a percentage (0-100)
        minimumGuaranteedBaseRate:
          type: number
          format: float
          minimum: 0
          maximum: 100
          description: Minimum base rate guaranteed on policy (0-100)
        rateEndDate:
          type: string
          format: date
          description: End date of current fund rate (yyyy-mm-dd)
        indexTermMaturityDate:
          type: string
          format: date
          description: The maturity date of the index term (yyyy-mm-dd)
        hasMVA:
          type: boolean
          description: Indicator for Market Value Adjustment presence
        mvaFundLevel:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: The fund level of the Market Value Adjustment

    RiderFee:
      type: object
      description: Rider fee information
      properties:
        riderType:
          type: string
          enum: 
            - BASE
            - RIDER
            - INTEGRATED_RIDER
            - BENEFIT_RIDER
            - INCOME_RIDER
            - DEATH_BENEFIT_RIDER
            - LTC_RIDER
            - GMWB_RIDER
            - GMDB_RIDER
            - GMAB_RIDER
            - CHARGE_RIDER
            - DISCOUNT
            - BASE_INCREASE
            - RIDER_INCREASE
            - OTHER
            - UNKNOWN
          description: Type of rider
        totalRiderFee:
          type: number
          format: float
          minimum: 0
          maximum: 100
          description: Total amount of fees for riders as a percentage (0-100)

    LivingBenefit:
      type: object
      description: Living benefit rider details
      required:
        - isActivated
        - hasLivingBenefit
        - type
      properties:
        hasLivingBenefit:
          type: boolean
          description: Does the policy have a living benefit?
        type:
          type: string
          maxLength: 180
          enum:
            - GMAB
            - GMWB
            - GMIB
            - GMWLB
            - EDB
            - LTC
            - chronicIllness
          description: Rider type
        coverage:
          type: string
          enum:
            - single
            - joint
          description: Type of coverage
        name:
          type: string
          maxLength: 180
          description: The name of the living benefit
        benefitBase:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: The current value of the living benefit
        isActivated:
          type: boolean
          description: Is the rider activated/turned on?
        activationDate:
          type: string
          format: date
          description: Date the living benefit was initiated (yyyy-mm-dd)
        incomeAmount:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: Living benefit payout dollar amount
        remainingHoldingPeriod:
          type: string
          description: Remaining required holding period for living benefit
        incomeStartDate:
          type: string
          format: date
          description: Date of the first payment from the Living Benefit (yyyy-mm-dd)
        rollupRate:
          type: number
          format: float
          minimum: 0
          maximum: 100
          description: Living benefit rollup rate as a percentage (0-100)
        rollupFrequency:
          type: string
          enum:
            - monthly
            - quarterly
            - semiAnnual
            - annual
          description: Frequency of the Living Benefit rollup rate
        rollupFrequencyDate:
          type: string
          format: date
          description: The date of the Living Benefit rollup rate (yyyy-mm-dd)
        cost:
          type: number
          format: float
          minimum: 0
          maximum: 100
          description: Living benefit fees/costs as a percentage (0-100)

    DeathBenefit:
      type: object
      description: Death benefit rider details
      properties:
        type:
          type: string
          maxLength: 180
          description: The type of death benefit rider
        name:
          type: string
          maxLength: 180
          description: The name of the death benefit rider
        guaranteedValue:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: The minimum death benefit value guaranteed on the contract
        currentValue:
          type: number
          format: float
          minimum: 0.00
          maximum: 9999999999.99
          description: The current value of the death benefit
        cost:
          type: number
          format: float
          minimum: 0
          maximum: 100
          description: Death benefit fees/costs as a percentage (0-100)

    LTCRider:
      type: object
      description: LTC Rider or HLTC-LTC details
      properties:
        specifiedAmount:
          type: number
          format: float
          description: The specific LTC benefit amount selected (Total Benefit Value - code TBV)
        maxMonthlyBenefit:
          type: number
          format: float
          description: The maximum LTC benefit payable per month (Maximum Monthly Benefit Value - code MMB)
  securitySchemes:
    oauth2:
      type: oauth2
      description: OAuth2 flows supported by this endpoint.
      flows:
        clientCredentials:
          tokenUrl: https://TOKEN_URL
          scopes:
            ioe.ceding-carrier.read: read access to protected resources            
            ioe.ceding-carrier.all: all access to protected resources

